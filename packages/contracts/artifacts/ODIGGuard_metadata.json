					"params": {
						"_keeperHub": "Address of the keeper hub.",
						"_oracle": "Price oracle address.",
						"_safeHarborRegistry": "Safe Harbor registry address.",
						"initialOwner": "Owner (2-step for safety)."
					}
				},
				"executeDefensiveStrategy(address,address,bytes)": {
					"params": {
						"lifiData": "ABI-encoded calldata for the LI.FI diamond call.",
						"lifiDiamond": "Address of the LI.FI diamond router.",
						"targetAsset": "Address of the asset being protected."
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"pendingOwner()": {
					"details": "Returns the address of the pending owner."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"transferOwnership(address)": {
					"details": "Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner. Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer."
				}
			},
			"stateVariables": {
				"_stablecoins": {
					"details": "Registered stablecoin assets (address => isPeg)."
				}
			},
