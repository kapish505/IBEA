# ─── Somnia Network ──────────────────────────────────────────────────────────
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WSS_URL=wss://dream-rpc.somnia.network
SOMNIA_CHAIN_ID=50312
SOMNIA_EXPLORER=https://shannon-explorer.somnia.network

# ─── Somnia Native Agent Addresses (fill in when live) ───────────────────────
# See packages/shared/src/agents.ts — inject as env vars, never hardcode
SOMNIA_JSON_API_AGENT_ADDRESS=0x0000000000000000000000000000000000000001
SOMNIA_WEBSITE_PARSE_AGENT_ADDRESS=0x0000000000000000000000000000000000000002
SOMNIA_LLM_INFERENCE_AGENT_ADDRESS=0x0000000000000000000000000000000000000003

# ─── IBEA Core Contract Addresses (set after deployment) ─────────────────────
NEXT_PUBLIC_IBEA_CORE_ADDRESS=
NEXT_PUBLIC_ESCALATION_GATE_ADDRESS=
NEXT_PUBLIC_THREAT_VECTOR_MATRIX_ADDRESS=
NEXT_PUBLIC_SEMANTIC_BURST_ENGINE_ADDRESS=
NEXT_PUBLIC_KEEPER_REGISTRY_ADDRESS=
NEXT_PUBLIC_SAFE_HARBOR_REGISTRY_ADDRESS=
NEXT_PUBLIC_ODIG_GUARD_ADDRESS=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ibea:ibea_dev_secret@localhost:5432/ibea
POSTGRES_USER=ibea
POSTGRES_PASSWORD=ibea_dev_secret
POSTGRES_DB=ibea

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:ibea_redis_dev@localhost:6379
REDIS_PASSWORD=ibea_redis_dev

# ─── Keeper ───────────────────────────────────────────────────────────────────
KEEPER_PRIVATE_KEY=                  # Somnia Shannon keeper EOA private key
KEEPER_MIN_CONFIRMATIONS=1

# ─── LI.FI ───────────────────────────────────────────────────────────────────
# LI.FI SDK uses real routes; no API key needed for basic calls
LIFI_INTEGRATOR=ibea-protocol
LIFI_API_URL=https://li.quest/v1

# ─── External Telemetry APIs ──────────────────────────────────────────────────
# Forta Alerts — https://api.forta.network
FORTA_API_URL=https://api.forta.network/alerts
FORTA_BOT_IDS=                       # comma-separated Forta bot IDs to monitor

# DefiLlama — public API, no key required
DEFILLAMA_API_URL=https://api.llama.fi

# Hypernative — enterprise API (optional; falls back to Forta if absent)
HYPERNATIVE_API_KEY=
HYPERNATIVE_API_URL=https://api.hypernative.xyz/v1

# ─── Frontend (Next.js public env) ───────────────────────────────────────────
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_SOMNIA_CHAIN_ID=50312
NEXT_PUBLIC_TELEMETRY_URL=http://localhost:3001
NEXT_PUBLIC_TELEMETRY_WS_URL=ws://localhost:3001
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # get from https://cloud.walletconnect.com

# ─── Ponder Indexer ───────────────────────────────────────────────────────────
PONDER_RPC_URL_50312=https://dream-rpc.somnia.network

# ─── Deployment ───────────────────────────────────────────────────────────────
# Vercel deployment (for frontend)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
